<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>editprofile</title>
</head>
<body>
    <h1>Edit Profile</h1>
    <form action="/students/updateprofile" method="POST">
         <div>
            <label for="profileImage">Profile Image:</label>
            <input type="text" id="profileImage" name="profileImage" value="<%= studentdata.profileImage %>">
        </div>
        <div>
            <label for="name">Name:</label>
            <input type="text" id="name" name="name" value="<%= studentdata.name %>">
        </div>
        <div>
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="<%= studentdata.email %>">
        </div>
        <div>
            <label for="phoneNumber">Phone Number:</label>
            <input type="text" id="phoneNumber" name="phoneNumber" value="<%= studentdata.phoneNumber %>">
        </div>
       
        <button type="submit">Update Profile</button>
    </form>
</body>
</html>